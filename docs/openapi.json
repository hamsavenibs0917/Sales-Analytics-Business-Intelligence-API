{
  "openapi": "3.0.3",
  "info": {
    "title": "Sales Analytics & Business Intelligence REST API",
    "version": "1.0.0",
    "description": "Production-grade Flask REST API providing sales management, bulk CSV/Excel ingestion, BI analytics (MoM/YoY growth, KPIs, regional breakdowns), and multi-sheet Excel/CSV reporting."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password", "full_name"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "analyst@company.com" },
          "password": { "type": "string", "format": "password", "minLength": 6, "example": "AnalystPass123!" },
          "full_name": { "type": "string", "example": "Jane Doe" },
          "role": { "type": "string", "enum": ["admin", "analyst", "user"], "default": "user" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "admin@company.com" },
          "password": { "type": "string", "format": "password", "example": "AdminPass123!" }
        }
      },
      "SaleCreateRequest": {
        "type": "object",
        "required": ["transaction_id", "customer_id", "product_id", "quantity", "unit_price", "sale_date", "region"],
        "properties": {
          "transaction_id": { "type": "string", "example": "TXN-2026-9001" },
          "customer_id": { "type": "integer", "example": 1 },
          "product_id": { "type": "integer", "example": 1 },
          "quantity": { "type": "integer", "minimum": 1, "example": 5 },
          "unit_price": { "type": "number", "format": "float", "example": 1199.99 },
          "unit_cost": { "type": "number", "format": "float", "example": 650.00 },
          "discount": { "type": "number", "format": "float", "default": 0.0, "example": 0.05 },
          "sale_date": { "type": "string", "format": "date", "example": "2026-08-15" },
          "region": { "type": "string", "example": "North" },
          "payment_method": { "type": "string", "default": "Credit Card", "example": "Credit Card" },
          "status": { "type": "string", "default": "Completed", "example": "Completed" }
        }
      },
      "CustomerCreateRequest": {
        "type": "object",
        "required": ["customer_code", "name", "region"],
        "properties": {
          "customer_code": { "type": "string", "example": "CUST-9001" },
          "name": { "type": "string", "example": "Quantum Technologies" },
          "email": { "type": "string", "format": "email", "example": "contact@quantum.io" },
          "phone": { "type": "string", "example": "+1-555-0199" },
          "region": { "type": "string", "example": "North" },
          "segment": { "type": "string", "enum": ["Consumer", "SMB", "Enterprise"], "default": "Consumer" }
        }
      },
      "ProductCreateRequest": {
        "type": "object",
        "required": ["sku", "name", "category", "unit_cost", "unit_price"],
        "properties": {
          "sku": { "type": "string", "example": "SKU-AI-900" },
          "name": { "type": "string", "example": "Enterprise Neural Accelerator" },
          "category": { "type": "string", "example": "Electronics" },
          "unit_cost": { "type": "number", "format": "float", "example": 800.00 },
          "unit_price": { "type": "number", "format": "float", "example": 1899.99 },
          "is_active": { "type": "boolean", "default": true }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user account",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "Validation error" },
          "409": { "description": "Email already exists" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate user and issue JWT tokens",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "JWT tokens issued successfully" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Retrieve profile of authenticated user",
        "responses": {
          "200": { "description": "User profile" }
        }
      }
    },
    "/api/v1/sales": {
      "get": {
        "tags": ["Sales Management"],
        "summary": "List sales records with pagination and multi-filter support",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "start_date", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "end_date", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "region", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "min_amount", "in": "query", "schema": { "type": "number" } },
          { "name": "max_amount", "in": "query", "schema": { "type": "number" } }
        ],
        "responses": {
          "200": { "description": "Paginated sales array" }
        }
      },
      "post": {
        "tags": ["Sales Management"],
        "summary": "Record a new sales transaction",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaleCreateRequest" } } }
        },
        "responses": {
          "201": { "description": "Sales record created" }
        }
      }
    },
    "/api/v1/sales/{id}": {
      "get": {
        "tags": ["Sales Management"],
        "summary": "Get sale by ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Sale detail" }, "404": { "description": "Not found" } }
      },
      "put": {
        "tags": ["Sales Management"],
        "summary": "Update sale by ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Sale updated" } }
      },
      "delete": {
        "tags": ["Sales Management"],
        "summary": "Delete sale by ID (Admin only)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Sale deleted" }, "403": { "description": "Forbidden" } }
      }
    },
    "/api/v1/sales/upload": {
      "post": {
        "tags": ["Sales Management"],
        "summary": "Upload and ingest CSV or Excel dataset",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Dataset cleaned and ingested successfully" }
        }
      }
    },
    "/api/v1/analytics/summary": {
      "get": {
        "tags": ["Business Intelligence & Analytics"],
        "summary": "Executive KPI summary (Revenue, Cost, Profit, Margin, AOV)",
        "parameters": [
          { "name": "start_date", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "end_date", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "region", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Calculated executive KPIs" }
        }
      }
    },
    "/api/v1/analytics/products/top": {
      "get": {
        "tags": ["Business Intelligence & Analytics"],
        "summary": "Top selling products by revenue, units, or profit",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "order_by", "in": "query", "schema": { "type": "string", "enum": ["revenue", "units_sold", "profit", "orders"], "default": "revenue" } }
        ],
        "responses": { "200": { "description": "Ranked product list" } }
      }
    },
    "/api/v1/analytics/regions": {
      "get": {
        "tags": ["Business Intelligence & Analytics"],
        "summary": "Regional sales and profit breakdown",
        "responses": { "200": { "description": "Regional performance data" } }
      }
    },
    "/api/v1/analytics/trends/monthly": {
      "get": {
        "tags": ["Business Intelligence & Analytics"],
        "summary": "Monthly sales trends with MoM % growth rates",
        "responses": {
          "200": { "description": "Monthly time-series array" }
        }
      }
    },
    "/api/v1/analytics/trends/yearly": {
      "get": {
        "tags": ["Business Intelligence & Analytics"],
        "summary": "Yearly sales trends with YoY % growth rates",
        "responses": {
          "200": { "description": "Yearly trends array" }
        }
      }
    },
    "/api/v1/analytics/customers/top": {
      "get": {
        "tags": ["Business Intelligence & Analytics"],
        "summary": "Top customer accounts by spend and transaction volume",
        "responses": { "200": { "description": "Top customers" } }
      }
    },
    "/api/v1/analytics/stats": {
      "get": {
        "tags": ["Business Intelligence & Analytics"],
        "summary": "Statistical distributions via NumPy/Pandas (mean, median, IQR)",
        "responses": { "200": { "description": "Statistical summary" } }
      }
    },
    "/api/v1/reports/export/csv": {
      "get": {
        "tags": ["Reports & Exports"],
        "summary": "Download filtered sales records as CSV",
        "responses": {
          "200": { "description": "CSV stream", "content": { "text/csv": {} } }
        }
      }
    },
    "/api/v1/reports/export/excel": {
      "get": {
        "tags": ["Reports & Exports"],
        "summary": "Download multi-tab corporate Excel report (.xlsx)",
        "responses": {
          "200": {
            "description": "Excel workbook binary stream",
            "content": { "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {} }
          }
        }
      }
    },
    "/api/v1/customers": {
      "get": {
        "tags": ["Customers"],
        "summary": "List customers with search and pagination",
        "responses": { "200": { "description": "Customers list" } }
      },
      "post": {
        "tags": ["Customers"],
        "summary": "Create customer",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerCreateRequest" } } }
        },
        "responses": { "201": { "description": "Customer created" } }
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List products with search and pagination",
        "responses": { "200": { "description": "Products list" } }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Create product (Admin/Analyst)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductCreateRequest" } } }
        },
        "responses": { "201": { "description": "Product created" } }
      }
    }
  }
}
