# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Database Configuration
# Local SQLite default: sqlite:///sales_bi.db
# PostgreSQL for production/Render: postgresql://username:password@localhost:5432/sales_analytics_db
DATABASE_URL=sqlite:///sales_bi.db

# File Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=csv,xlsx,xls

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
